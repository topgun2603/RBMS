    { "id": "desc-08", "feature": "product-description", "lang": "ta", "prompt": "பெயர்: பருத்தி சேலை. 6.2 மீட்டர். நிறம்: பச்சை. விலை ரூ 1200. பிளவுஸ் துணி சேர்ந்தது.", "expect": { "mustMention": ["cotton"], "mustNotContain": ["silk"] }, "note": "Request in Tamil; both descriptions still produced. Tamil text must be natural, not a word-for-word translation." },
    { "id": "desc-09", "feature": "product-description", "lang": "ta", "prompt": "பெயர்: கடலை எண்ணெய் 1 லிட்டர். செக்கில் ஆட்டியது. பாட்டிலில் அடைக்கப்பட்டது.", "expect": { "mustMention": ["oil"], "mustNotContain": ["refined", "cholesterol"] }, "note": "'Chekku' (wood-pressed) should be conveyed." },
    { "id": "desc-10", "feature": "product-description", "lang": "ta", "prompt": "பெயர்: மண் பானை 10 லிட்டர். கையால் செய்தது. தண்ணீர் குளிர்ச்சியாக இருக்கும்.", "expect": { "mustMention": ["clay"], "mustNotContain": ["plastic"] }, "note": "Clay pot." },
    { "id": "desc-11", "feature": "product-description", "lang": "ta", "prompt": "பெயர்: குழந்தைகள் பருத்தி டி-ஷர்ட். வயது 2 முதல் 5. நிறங்கள்: மஞ்சள், நீலம்.", "expect": { "mustMention": ["cotton"], "mustNotContain": ["polyester"] }, "note": "Kids' t-shirt." },
    { "id": "desc-12", "feature": "product-description", "lang": "ta", "prompt": "பெயர்: வெள்ளி கொலுசு. எடை 40 கிராம். 925 வெள்ளி. ஒரு ஜோடி.", "expect": { "mustMention": ["silver", "925"], "mustNotContain": ["gold", "hallmark"] }, "note": "No hallmark claim unless given." },
