{
  "version": 1,
  "description": "100 realistic shop prompts in Tamil (ta), Tanglish (tanglish: Tamil in Roman letters) and English (en) for the AI helpers coming after Phase 0. Each case has a machine check in `expect` (used by the runner) and a human `note` saying what a good answer looks like. HSN prefixes are 4-digit headings; GST rates are deliberately NOT asserted because they change by notification: verify against the current rate list before a helper ships. Phone numbers and names are made up.",
  "features": {
    "ask-shop": "Turns a question into an intent (which read-only report to run). Write actions must come back as unsupported.",
    "hsn-suggest": "Suggests the HSN/SAC code for an item name.",
    "product-description": "Writes a short English and Tamil product description from the facts given, adding no facts.",
    "studio": "Turns a request about a product photo into one edit action."
  },
  "cases": [
    { "id": "ask-01", "feature": "ask-shop", "lang": "ta", "prompt": "இன்று எவ்வளவு விற்பனை ஆச்சு?", "expect": { "intent": "sales_today" }, "note": "Today's sales total." },
    { "id": "ask-02", "feature": "ask-shop", "lang": "ta", "prompt": "நேத்து விற்பனை எவ்வளவு?", "expect": { "intent": "sales_period", "period": "yesterday" }, "note": "Colloquial 'nethu' = yesterday." },
    { "id": "ask-03", "feature": "ask-shop", "lang": "ta", "prompt": "இந்த மாசம் மொத்த விற்பனை என்ன?", "expect": { "intent": "sales_period", "period": "this_month" }, "note": "'masam' = month, colloquial." },
    { "id": "ask-04", "feature": "ask-shop", "lang": "ta", "prompt": "கடந்த மாதம் எவ்வளவு வியாபாரம் நடந்தது?", "expect": { "intent": "sales_period", "period": "last_month" }, "note": "Last month's sales." },
    { "id": "ask-05", "feature": "ask-shop", "lang": "ta", "prompt": "எனக்கு யார் யார் பணம் தர வேண்டும்?", "expect": { "intent": "dues_customers" }, "note": "Customers who owe the shop." },
    { "id": "ask-06", "feature": "ask-shop", "lang": "ta", "prompt": "யாருக்கெல்லாம் பாக்கி இருக்கு?", "expect": { "intent": "dues_customers" }, "note": "'Baaki' = outstanding balance." },
    { "id": "ask-07", "feature": "ask-shop", "lang": "ta", "prompt": "சப்ளையர்களுக்கு நான் எவ்வளவு கொடுக்க வேண்டும்?", "expect": { "intent": "payables" }, "note": "What the shop owes suppliers." },
    { "id": "ask-08", "feature": "ask-shop", "lang": "ta", "prompt": "எந்தப் பொருள் அதிகம் விற்பனை ஆகிறது?", "expect": { "intent": "top_items" }, "note": "Best sellers, no period given." },
    { "id": "ask-09", "feature": "ask-shop", "lang": "ta", "prompt": "எந்தப் பொருள் ஸ்டாக் குறைவா இருக்கு?", "expect": { "intent": "low_stock" }, "note": "Items running low." },
    { "id": "ask-10", "feature": "ask-shop", "lang": "ta", "prompt": "இந்த மாத GST எவ்வளவு கட்ட வேண்டும்?", "expect": { "intent": "gst_summary", "period": "this_month" }, "note": "GST payable this month." },
    { "id": "ask-11", "feature": "ask-shop", "lang": "ta", "prompt": "இந்த வாரம் செலவு எவ்வளவு?", "expect": { "intent": "expenses_summary", "period": "this_week" }, "note": "Expenses this week." },
    { "id": "ask-12", "feature": "ask-shop", "lang": "ta", "prompt": "இந்த மாதம் லாபம் எவ்வளவு?", "expect": { "intent": "profit", "period": "this_month" }, "note": "Profit this month." },
    { "id": "ask-13", "feature": "ask-shop", "lang": "ta", "prompt": "எல்லா பில்களையும் அழித்துவிடு", "expect": { "intent": "unsupported" }, "note": "A destructive write action: must be refused, never run." },
    { "id": "ask-14", "feature": "ask-shop", "lang": "ta", "prompt": "ஒரு நகைச்சுவை சொல்லு", "expect": { "intent": "unsupported" }, "note": "Off topic." },
