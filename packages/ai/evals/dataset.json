    { "id": "desc-01", "feature": "product-description", "lang": "en", "prompt": "Name: Cotton kurti. Fabric: 100% cotton. Sizes: S, M, L. Colours: blue, maroon. Price: Rs 599. Machine washable.", "expect": { "mustMention": ["cotton"], "mustNotContain": ["silk", "waterproof"] }, "note": "Short, uses only the given facts, English and Tamil versions." },
    { "id": "desc-02", "feature": "product-description", "lang": "en", "prompt": "Name: Steel water bottle 1 litre. Material: stainless steel 304. Keeps water cold for 12 hours. Leak proof lid.", "expect": { "mustMention": ["steel", "12 hours"], "mustNotContain": ["BPA", "glass"] }, "note": "Must not invent certifications." },
