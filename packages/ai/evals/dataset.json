    { "id": "desc-05", "feature": "product-description", "lang": "en", "prompt": "Name: Kids school bag. 25 litre. Three zip compartments. Padded straps. Colours: red, black.", "expect": { "mustMention": ["25"], "mustNotContain": ["waterproof"] }, "note": "No waterproof claim." },
