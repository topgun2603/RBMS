{
  "name": "@srirealtime/ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "eval": "tsx --env-file-if-exists=../../.env.local --env-file-if-exists=../../apps/api/.env --env-file-if-exists=../../apps/api/.env.local evals/run.ts",
    "eval:phase1": "tsx --env-file-if-exists=../../.env.local --env-file-if-exists=../../apps/api/.env --env-file-if-exists=../../apps/api/.env.local evals/phase1.ts",
    "eval:vision": "tsx --env-file-if-exists=../../.env.local --env-file-if-exists=../../apps/api/.env --env-file-if-exists=../../apps/api/.env.local evals/run-vision.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@srirealtime/core": "workspace:*",
    "@srirealtime/db": "workspace:*",
    "@srirealtime/gst": "workspace:*",
    "drizzle-orm": "^0.44.0",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "fastify": "^5.3.0"
  },
  "devDependencies": {
    "fastify": "^5.3.0",
    "tsx": "^4.20.0"
  }
}
