{
  "name": "rbms",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @rbms/api db:generate",
    "db:migrate": "pnpm --filter @rbms/api db:migrate",
    "seed": "pnpm --filter @rbms/api seed",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "ops:backup": "node scripts/ops/backup-db.mjs",
    "ops:restore": "node scripts/ops/restore-db.mjs",
    "ops:drill": "node scripts/ops/restore-drill.mjs",
    "test:ops": "vitest run scripts/ops"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  },
  "pnpm": {
    "patchedDependencies": {
      "next@15.5.27": "patches/next@15.5.27.patch"
    }
  }
}
