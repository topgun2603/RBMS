# Copy to apps/api/.env
NODE_ENV=development
PORT=4000
APP_NAME=Srirealtime
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://*.localhost:3001,http://localhost:3002,http://*.localhost:3002,http://localhost:3003,http://*.localhost:3003
# Random 32+ chars in production (signs local upload URLs)
APP_SECRET=dev-only-secret-change-me
DATABASE_URL=postgres://srikit:srikit@localhost:5432/srikit
# Use "memory" to run without Redis (jobs run in-process, cron disabled)
REDIS_URL=redis://localhost:6379
# Phone or email that `pnpm seed` makes super-admin
SEED_SUPERADMIN=

# Root domain used to resolve tenants from subdomains (acme.srikit.local -> "acme")
ROOT_DOMAIN=localhost
SESSION_TTL_DAYS=30
OTP_TTL_MINUTES=10
# Development only (ignored when NODE_ENV=production): fixed OTP for test identities used by the e2e scripts.
# Matching targets get no message, skip the resend/hourly limits and accept this code. Unset = off.
# TEST_OTP_CODE=123456
# TEST_OTP_TARGETS=+9199990*,e2e-*@example.com
GOOGLE_CLIENT_ID=

# Uploads: local | s3 (S3 adapter also works with Cloudflare R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional CDN / public bucket URL for public files
PUBLIC_UPLOAD_BASE_URL=

# Notification providers (leave blank to log to console in development)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_FLOW_ID=
RESEND_API_KEY=
EMAIL_FROM=no-reply@srirealtime.com
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
FCM_SERVICE_ACCOUNT_JSON=
# Where each app mounts billing (share links); {slug} = shop subdomain. One template, or APP=template pairs.
BILLING_PUBLIC_URL=BL=http://{slug}.localhost:3001,EC=http://{slug}.localhost:3002/billing
# Online store URL for sitemap/robots ({slug} = shop subdomain; verified custom domains win)
STORE_PUBLIC_URL=http://{slug}.localhost:3003
# Shops point custom domains here (CNAME)
CNAME_TARGET=stores.srikit.in
