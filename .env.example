# Copy to apps/api/.env
NODE_ENV=development
PORT=4000
APP_NAME=Srirealtime
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://*.localhost:3001,http://localhost:3002,http://*.localhost:3002,http://localhost:3003,http://*.localhost:3003,http://localhost:3004,http://*.localhost:3004,http://localhost:3005,http://localhost:3006,http://*.localhost:3006,http://localhost:3007,http://*.localhost:3007,http://localhost:3008,http://*.localhost:3008,http://localhost:3009,http://*.localhost:3009
# Random 32+ chars in production (signs local upload URLs)
APP_SECRET=dev-only-secret-change-me
DATABASE_URL=postgres://srikit:srikit@localhost:5432/srikit
# Use "memory" to run without Redis (jobs run in-process, cron disabled)
REDIS_URL=redis://localhost:6379
# Phone or email that `pnpm seed` makes super-admin
SEED_SUPERADMIN=

# Root domain used to resolve tenants from subdomains (acme.srikit.local -> "acme")
ROOT_DOMAIN=localhost
SESSION_TTL_DAYS=30
OTP_TTL_MINUTES=10
# Development only (ignored when NODE_ENV=production): fixed OTP for test identities used by the e2e scripts.
# Matching targets get no message, skip the resend/hourly limits and accept this code. Unset = off.
# TEST_OTP_CODE=123456
# TEST_OTP_TARGETS=+9199990*,e2e-*@example.com

# Read-only live demo (docs/demo-access.md): shop slugs, comma-separated, that POST /v1/auth/demo may sign visitors into.
# Empty = no demo sign-in (the default; keep it empty in production unless you run public demos).
# DEMO_SHOPS=kumar,raja,arusuvai,vaasam,theneer,thunai,techzone,sukham,thaiyal,quickfix,lakshmi
GOOGLE_CLIENT_ID=
# Firebase phone sign-in (docs/firebase-auth.md): the project id only, no service account. Set = phones verify with
# Firebase (Google sends the SMS, no DLT registration); in production SMS codes from /otp/request are then refused
# unless MSG91 is configured. Unset = phones use the OTP flow.
FIREBASE_PROJECT_ID=

# Uploads: local | s3 (S3 adapter also works with Cloudflare R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.uploads
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional CDN / public bucket URL for public files
PUBLIC_UPLOAD_BASE_URL=

# Notification providers (leave blank to log to console in development)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_FLOW_ID=
RESEND_API_KEY=
EMAIL_FROM=no-reply@srirealtime.com
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
FCM_SERVICE_ACCOUNT_JSON=
# Where each app mounts billing (share links); {slug} = shop subdomain. One template, or APP=template pairs.
BILLING_PUBLIC_URL=BL=http://{slug}.localhost:3001,EC=http://{slug}.localhost:3002/billing,PH=http://{slug}.localhost:3006,RS=http://{slug}.localhost:3007/billing,SV=http://{slug}.localhost:3008
# Online store URL for sitemap/robots ({slug} = shop subdomain; verified custom domains win)
STORE_PUBLIC_URL=http://{slug}.localhost:3003
# On-demand store refresh after staff edits: the API posts to the store app (apps/store /api/revalidate) with a
# shared secret (set the same STORE_REVALIDATE_SECRET in the store app). Dev defaults apply when unset outside
# production; in production both must be set or the store relies on its time-based refresh. "off" disables.
# STORE_REVALIDATE_URL=http://127.0.0.1:3003/api/revalidate
# STORE_REVALIDATE_SECRET=
# Shops point custom domains here (CNAME)
CNAME_TARGET=stores.srikit.in

# ---- Plan subscriptions (docs/batch5.md)
# The platform's own Razorpay account (all three, or none = mock provider in development; production then answers 503)
PLATFORM_RAZORPAY_KEY_ID=
PLATFORM_RAZORPAY_KEY_SECRET=
PLATFORM_RAZORPAY_WEBHOOK_SECRET=
# The platform as seller on plan invoices (18% GST: CGST+SGST for shops in PLATFORM_STATE_CODE, IGST otherwise)
PLATFORM_LEGAL_NAME=Srirealtime
PLATFORM_GSTIN=
PLATFORM_STATE_CODE=33
PLATFORM_ADDRESS=
PLATFORM_INVOICE_PREFIX=SR
# Public landing site (sign-up, pricing)
WWW_PUBLIC_URL=http://localhost:3005
# Where each app opens a shop ({slug} = subdomain): sign-up's appUrl and login handoff links
APP_PUBLIC_URL=BL=http://{slug}.localhost:3001,EC=http://{slug}.localhost:3002,PH=http://{slug}.localhost:3006,RS=http://{slug}.localhost:3007,SV=http://{slug}.localhost:3008,SC=http://{slug}.localhost:3009

# ---- Operational safety net (docs/ops.md)
# Sentry-compatible DSN: 5xx errors and final job failures are sent there (unset = logged only)
SENTRY_DSN=
SENTRY_ENVIRONMENT=
# Bearer token for GET /metrics (Prometheus); unset = /metrics disabled. 16+ random chars.
METRICS_TOKEN=
# Build info for GET /version and error-report releases (set by the image build)
GIT_SHA=
BUILD_TIME=
# Per-dependency timeout of GET /ready (ms)
READY_TIMEOUT_MS=2000
# pino level (default debug in development, info otherwise)
LOG_LEVEL=

# HTTP hardening (apps/api/src/http-guard.ts): fixed-window rate limits, shared through Redis when REDIS_URL is set
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
# per client IP / per signed-in user / per shop / per IP on the sign-in routes (OTP, Google, Firebase, 2FA). Defaults 600/900/6000/30, 10x in development
# RATE_LIMIT_IP_MAX=600
# RATE_LIMIT_USER_MAX=900
# RATE_LIMIT_TENANT_MAX=6000
# RATE_LIMIT_AUTH_MAX=30
# Largest JSON request body in bytes (default 1 MiB)
BODY_LIMIT_BYTES=1048576

# AI foundation (docs/ai.md). Everything works without a key: the sample (mock) provider answers in development.
# Anthropic API key. Empty = sample provider outside production; in production AI answers 503 ai_unavailable.
ANTHROPIC_API_KEY=
# Only for a key that is NOT scoped to a workspace: the workspace id (Console > Workspaces), sent as anthropic-workspace-id.
ANTHROPIC_WORKSPACE_ID=
# Platform kill switch. Default: true in development, false in production until you set it to true.
AI_ENABLED=true
# auto = Claude when a key is set, else the sample provider (development). mock = always the sample provider.
AI_PROVIDER=auto
# Model per tier (exact ids, no date suffix). Switch standard / vision to claude-sonnet-5-5 to save cost.
AI_MODEL_LIGHT=claude-haiku-5-5
AI_MODEL_STANDARD=claude-opus-5-5
AI_MODEL_VISION=claude-opus-5-5
# Rupees per US dollar, only to show what a credit costs in rupees on the AI settings page
AI_USD_INR=85

# Backups (scripts/ops, run from the repo root; they read DATABASE_URL from apps/api/.env when unset)
# Upload dumps to S3 when set; otherwise they go to ./backups
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=db/
BACKUP_S3_REGION=ap-south-1
BACKUP_S3_ENDPOINT=
# Retention: newest backup of each of the last N days and of each of the last M months
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_MONTHLY=12


