{
  "name": "@rbms/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env.local --env-file-if-exists=.env --env-file-if-exists=.env.local src/main.ts",
    "start": "tsx --env-file-if-exists=../../.env.local --env-file-if-exists=.env --env-file-if-exists=.env.local src/main.ts",
    "build": "node build.mjs",
    "start:prod": "node dist/main.mjs",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "seed:stores": "tsx --env-file-if-exists=.env src/seed-stores.ts",
    "seed:history": "tsx --env-file-if-exists=.env src/seed-history.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:prod": "node dist/migrate.mjs",
    "migrate:items": "tsx --env-file-if-exists=.env src/scripts/migrate-items.ts",
    "migrate:locations": "tsx --env-file-if-exists=.env src/scripts/backfill-locations.ts",
    "migrate:search": "tsx --env-file-if-exists=.env src/scripts/rebuild-search.ts",
    "job": "tsx --env-file-if-exists=.env src/scripts/run-job.ts",
    "analytics:backfill": "tsx --env-file-if-exists=.env src/scripts/analytics-backfill.ts",
    "openapi": "tsx --env-file-if-exists=.env src/scripts/export-openapi.ts",
    "release-notes:draft": "tsx src/scripts/release-notes-draft.ts",
    "test:e2e": "node test/e2e/batch1.mjs",
    "test:e2e:2": "node test/e2e/batch2.mjs",
    "test:e2e:3": "node test/e2e/batch3.mjs",
    "seed:e2e": "tsx --env-file-if-exists=.env src/seed-e2e.ts",
    "cleanup:e2e-data": "tsx --env-file-if-exists=.env src/scripts/cleanup-e2e-data.ts",
    "test:e2e:billing": "node test/e2e/billing.mjs",
    "test:e2e:all": "node test/e2e/run-all.mjs"
  },
