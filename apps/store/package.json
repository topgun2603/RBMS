{
  "name": "@rbms/store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Customer-facing online store (D2C): each shop on its own subdomain or custom domain, server-rendered for SEO. Theme: @rbms/storefront-ui.",
  "scripts": {
    "tryon:assets": "node scripts/tryon-assets.mjs",
    "predev": "node scripts/tryon-assets.mjs",
    "prebuild": "node scripts/tryon-assets.mjs",
    "dev": "next dev --turbopack -p 3003",
    "build": "next build",
    "start": "next start -p 3003",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:e2e": "node test/e2e.cjs"
  },
  "dependencies": {
    "@rbms/cms": "workspace:*",
    "@rbms/i18n": "workspace:*",
    "@rbms/storefront-ui": "workspace:*",
    "@rbms/ui": "workspace:*",
    "@tanstack/react-query": "^5.83.0",
    "lucide-react": "^0.525.0",
    "next": "^15.5.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0"
  }
}
