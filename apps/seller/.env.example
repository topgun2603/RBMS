NEXT_PUBLIC_API_URL=http://localhost:4000
# Shops open the seller app at <slug>.<root domain>, e.g. anbu.localhost:3004 in dev.
NEXT_PUBLIC_ROOT_DOMAIN=localhost
# Optional: the storefront URL for "View seller page" ({slug} = shop subdomain), e.g. http://{slug}.localhost:3003
# NEXT_PUBLIC_STORE_URL=
# Firebase phone sign-in (docs/firebase-auth.md). Copy into .env.local. All four set = phones verify with Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Hosts where phone sign-in runs in place: exact names or ".suffix" for all subdomains (mirror Firebase's authorized
# domains). Other hosts (per-shop subdomains) verify the number on the landing site and come back with a handoff code.
NEXT_PUBLIC_FIREBASE_AUTH_HOSTS=localhost
# The landing site (apps/www) that does that phone check.
NEXT_PUBLIC_WWW_URL=http://localhost:3005
