# Firebase phone sign-in (docs/firebase-auth.md). Copy into .env.local. All four set = phones verify with Firebase.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Shop-app / admin login pages /login may send a phone sign-in back to (?return=), `*` = one subdomain label.
# Never include the storefront origins.
NEXT_PUBLIC_PHONE_RETURN_ORIGINS=http://localhost:3000,http://localhost:3001,http://*.localhost:3001,http://localhost:3002,http://*.localhost:3002,http://localhost:3004,http://*.localhost:3004,http://localhost:3006,http://*.localhost:3006,http://localhost:3007,http://*.localhost:3007,http://localhost:3008,http://*.localhost:3008
