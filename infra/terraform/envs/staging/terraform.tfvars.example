# Copy to terraform.tfvars (gitignored) and fill in. Secrets never go here: they are generated (APP_SECRET, ...)
# or set with `aws ssm put-parameter` (provider_secrets). See docs/deploy-aws.md.

aws_account_id = "123456789012" # the account you chose for srikit; Terraform refuses any other credentials
region         = "ap-south-1"

# No domain yet: leave empty. Later: domain = "rbms.in" (Route 53 zone created here unless route53_zone_id is set).
domain = ""
# create_route53_zone = true
# route53_zone_id     = "Z0123456789ABCDEF"

# Keep staging private: your office / home / VPN addresses.
allowed_cidrs = ["0.0.0.0/0"]

alarm_emails = ["ops@example.com"]

# GitHub OIDC deploy role for .github/workflows/deploy.yml (owner/repo). Empty = no role.
github_repository = ""
# create_github_oidc_provider = false   # if the account already has token.actions.githubusercontent.com

# First apply: 0 (no images in ECR yet). Then 1.
desired_count = 0
use_spot      = true
worker_mode   = "sidecar"

# No-domain mode: the shop the store shows on the bare ALB host (the demo seed creates "anbu").
store_default_tenant = "anbu"

# Plain API settings (non-secret).
api_environment = {
  EMAIL_FROM          = "no-reply@example.com"
  PLATFORM_LEGAL_NAME = "RBMS"
  # PLATFORM_GSTIN    = "33AAAAA0000A1Z5"
  # PLATFORM_ADDRESS  = "..."
  # Required in production (the API refuses the mock KYC provider at boot). Use the provider's sandbox for staging.
  KYC_BASE_URL      = "https://sandbox.example-kyc.in"
  KYC_PROVIDER_NAME = "surepass"
  # GOOGLE_CLIENT_ID = "....apps.googleusercontent.com"
  # MSG91_SENDER_ID  = "SRIRTM"
  # MSG91_OTP_FLOW_ID = "..."
}

# Secret API settings: created as CHANGE_ME, then set by hand (aws ssm put-parameter --overwrite).
provider_secrets = [
  "KYC_TOKEN",
  # "SENTRY_DSN",
  # "RESEND_API_KEY",
  # "MSG91_AUTH_KEY",
  # "PLATFORM_RAZORPAY_KEY_ID", "PLATFORM_RAZORPAY_KEY_SECRET", "PLATFORM_RAZORPAY_WEBHOOK_SECRET",
]

# Extra build-time values for the Next apps.
next_public = {
  # NEXT_PUBLIC_GOOGLE_CLIENT_ID = "....apps.googleusercontent.com"
  # NEXT_PUBLIC_CONTACT_EMAIL    = "hello@example.com"
}
